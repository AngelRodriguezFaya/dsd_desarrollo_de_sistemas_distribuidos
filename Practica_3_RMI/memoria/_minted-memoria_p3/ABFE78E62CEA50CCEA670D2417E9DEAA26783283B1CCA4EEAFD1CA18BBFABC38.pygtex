\PYG{+w}{	}\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Devuelve el nombre del donante que ha donado la mayor cantidad de dinero }
\PYG{c+cm}{     * desde que se registró en el sistema. Si hay varios donantes con la misma cantidad, }
\PYG{c+cm}{     * se devuelve el que primero se encuentre en la lista de donantes registrados.}
\PYG{c+cm}{     * @return String. El nombre del donante.}
\PYG{c+cm}{     * @throws RemoteException Si ocurre un error de comunicación remota.}
\PYG{c+cm}{     */}
\PYG{+w}{	}\PYG{n+nd}{@Override}
\PYG{+w}{	}\PYG{k+kd}{public}\PYG{+w}{ }\PYG{n}{String}\PYG{+w}{ }\PYG{n+nf}{mayorDonanteGlobal}\PYG{p}{()}\PYG{+w}{ }\PYG{k+kd}{throws}\PYG{+w}{ }\PYG{n}{RemoteException}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{		}\PYG{c+c1}{// 1. Obtenemos TODOS los donantes del sistema }
\PYG{+w}{		}\PYG{c+c1}{// Primero obtenemos los donantes registrados en esta réplica.}
\PYG{+w}{		}\PYG{n}{List}\PYG{o}{\PYGZlt{}}\PYG{n}{String}\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{todosLosDonantes}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k}{this}\PYG{p}{.}\PYG{n+na}{listarDonantesLocal}\PYG{p}{();}
\PYG{+w}{		}\PYG{k}{for}\PYG{p}{(}\PYG{n}{iDonacion}\PYG{+w}{ }\PYG{n}{peer}\PYG{+w}{ }\PYG{p}{:}\PYG{+w}{ }\PYG{n}{peers}\PYG{p}{.}\PYG{n+na}{values}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}\PYG{c+c1}{// Ahora obtenemos los donantes registrados en las otras réplicas.}
\PYG{+w}{			}\PYG{n}{todosLosDonantes}\PYG{p}{.}\PYG{n+na}{addAll}\PYG{p}{(}\PYG{n}{peer}\PYG{p}{.}\PYG{n+na}{listarDonantesLocal}\PYG{p}{());}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}

\PYG{+w}{		}\PYG{n}{String}\PYG{+w}{ }\PYG{n}{mayorDonante}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k+kc}{null}\PYG{p}{;}
\PYG{+w}{		}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{maxCantidad}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{;}

\PYG{+w}{		}\PYG{c+c1}{// 2. Iteramos para encontrar el donante }
\PYG{+w}{		}\PYG{k}{for}\PYG{p}{(}\PYG{n}{String}\PYG{+w}{ }\PYG{n}{d}\PYG{+w}{ }\PYG{p}{:}\PYG{+w}{ }\PYG{n}{todosLosDonantes}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{totalDeEsteDonante}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k}{this}\PYG{p}{.}\PYG{n+na}{getTotalDonacionesDonante}\PYG{p}{(}\PYG{n}{d}\PYG{p}{);}\PYG{+w}{ }\PYG{c+c1}{// Consulta su total }
\PYG{+w}{			}
\PYG{+w}{			}\PYG{c+c1}{// Si la cantidad es estrictamente MAYOR, se actualiza el máximo.}
\PYG{+w}{			}\PYG{c+c1}{// Si es IGUAL, no se actualiza, por lo que Conservamos el que aparece antes en la lista.}
\PYG{+w}{			}\PYG{k}{if}\PYG{p}{(}\PYG{n}{totalDeEsteDonante}\PYG{+w}{ }\PYG{o}{\PYGZgt{}}\PYG{+w}{ }\PYG{n}{maxCantidad}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{				}\PYG{n}{maxCantidad}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{totalDeEsteDonante}\PYG{p}{;}
\PYG{+w}{				}\PYG{n}{mayorDonante}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{d}\PYG{p}{;}
\PYG{+w}{			}\PYG{p}{\PYGZcb{}}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}
\PYG{+w}{		}
\PYG{+w}{		}\PYG{k}{return}\PYG{+w}{ }\PYG{n}{mayorDonante}\PYG{p}{;}
\PYG{+w}{	}\PYG{p}{\PYGZcb{}}

\PYG{+w}{	}\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Permite a un donante consultar su historial de donaciones.}
