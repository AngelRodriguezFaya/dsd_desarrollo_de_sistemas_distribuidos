\PYG{+w}{	}\PYG{c+cm}{/**}
\PYG{c+cm}{	 * @brief Permite registrar un donante. }
\PYG{c+cm}{	 * }
\PYG{c+cm}{	 * @param donante El nombre del donante a registrar. }
\PYG{c+cm}{	 * @return iDonacion. El servidor (réplica) donde se ha registrado el donante.}
\PYG{c+cm}{	 * @throws RemoteException Si ocurre un error de comunicación remota. }
\PYG{c+cm}{	 */}
\PYG{+w}{	}\PYG{n+nd}{@Override}
\PYG{+w}{	}\PYG{k+kd}{public}\PYG{+w}{ }\PYG{n}{iDonacion}\PYG{+w}{ }\PYG{n+nf}{registrar}\PYG{p}{(}\PYG{n}{String}\PYG{+w}{ }\PYG{n}{donante}\PYG{p}{)}\PYG{+w}{ }\PYG{k+kd}{throws}\PYG{+w}{ }\PYG{n}{RemoteException}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{		}\PYG{n}{iDonacion}\PYG{+w}{ }\PYG{n}{peerRegistrado}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k+kc}{null}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// Réplica donde se ha registrado el donante}

\PYG{+w}{		}\PYG{c+c1}{// 1. Comprobar si el donante ya está registrado en esta réplica. }
\PYG{+w}{		}\PYG{k}{if}\PYG{p}{(}\PYG{k}{this}\PYG{p}{.}\PYG{n+na}{estaRegistrado}\PYG{p}{(}\PYG{n}{donante}\PYG{p}{))}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}\PYG{n}{peerRegistrado}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k}{this}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// El donante ya está registrado en esta réplica}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}\PYG{c+c1}{// 2. Comprobamos si no esta registrado en alguna de las otras réplicas}
\PYG{+w}{			}\PYG{k}{for}\PYG{p}{(}\PYG{n}{iDonacion}\PYG{+w}{ }\PYG{n}{peer}\PYG{+w}{ }\PYG{p}{:}\PYG{+w}{ }\PYG{n}{peers}\PYG{p}{.}\PYG{n+na}{values}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{				}\PYG{k}{if}\PYG{p}{(}\PYG{n}{peer}\PYG{p}{.}\PYG{n+na}{estaRegistrado}\PYG{p}{(}\PYG{n}{donante}\PYG{p}{))}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{					}\PYG{n}{peerRegistrado}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{peer}\PYG{p}{;}\PYG{+w}{ }
\PYG{+w}{					}\PYG{k}{break}\PYG{p}{;}\PYG{+w}{ }
\PYG{+w}{				}\PYG{p}{\PYGZcb{}}
\PYG{+w}{			}\PYG{p}{\PYGZcb{}}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}

\PYG{+w}{		}\PYG{c+c1}{// Si el donante no está registrado en ninguna réplica, lo registramos en}
\PYG{+w}{		}\PYG{c+c1}{// la réplica con menos donantes registrados para balancear la carga entre las réplicas.}
\PYG{+w}{		}\PYG{k}{if}\PYG{p}{(}\PYG{n}{peerRegistrado}\PYG{+w}{ }\PYG{o}{==}\PYG{+w}{ }\PYG{k+kc}{null}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}
\PYG{+w}{			}\PYG{c+c1}{// 3. Encontramos la réplica con menos donantes registrados}
\PYG{+w}{			}\PYG{n}{iDonacion}\PYG{+w}{ }\PYG{n}{mejorPeer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k}{this}\PYG{p}{;}\PYG{+w}{	}\PYG{c+c1}{// Mejor réplica encontrada para registrar el nuevo donante}
\PYG{+w}{			}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{minDonantes}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k}{this}\PYG{p}{.}\PYG{n+na}{totalDonantes}\PYG{p}{();}\PYG{+w}{ }\PYG{c+c1}{// Minimo nro de donantes registrado en la mejorPeer}

\PYG{+w}{			}\PYG{k}{for}\PYG{p}{(}\PYG{n}{iDonacion}\PYG{+w}{ }\PYG{n}{peer}\PYG{+w}{ }\PYG{p}{:}\PYG{+w}{ }\PYG{n}{peers}\PYG{p}{.}\PYG{n+na}{values}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{				}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{nroDonantesPeer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{peer}\PYG{p}{.}\PYG{n+na}{totalDonantes}\PYG{p}{();}
\PYG{+w}{				}\PYG{k}{if}\PYG{p}{(}\PYG{n}{nroDonantesPeer}\PYG{+w}{ }\PYG{o}{\PYGZlt{}}\PYG{+w}{ }\PYG{n}{minDonantes}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{					}\PYG{n}{mejorPeer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{peer}\PYG{p}{;}
\PYG{+w}{					}\PYG{n}{minDonantes}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{nroDonantesPeer}\PYG{p}{;}
\PYG{+w}{				}\PYG{p}{\PYGZcb{}}
\PYG{+w}{			}\PYG{p}{\PYGZcb{}}

\PYG{+w}{			}\PYG{c+c1}{// 4. Registramos el nuevo donante en la mejor réplica encontrada}
\PYG{+w}{			}\PYG{k}{if}\PYG{p}{(}\PYG{n}{mejorPeer}\PYG{p}{.}\PYG{n+na}{getNombre}\PYG{p}{().}\PYG{n+na}{equals}\PYG{p}{(}\PYG{k}{this}\PYG{p}{.}\PYG{n+na}{getNombre}\PYG{p}{()))}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{				}\PYG{k+kd}{synchronized}\PYG{p}{(}\PYG{k}{this}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{+w}{ }\PYG{c+c1}{// Lo hacemos de exclusión mutua para evitar condiciones de carrera}
\PYG{+w}{					}\PYG{n}{donantes}\PYG{p}{.}\PYG{n+na}{putIfAbsent}\PYG{p}{(}\PYG{n}{donante}\PYG{p}{,}\PYG{+w}{ }\PYG{k}{new}\PYG{+w}{ }\PYG{n}{ArrayList}\PYG{o}{\PYGZlt{}\PYGZgt{}}\PYG{p}{());}\PYG{+w}{ }\PYG{c+c1}{// Registramos de forma segura}
\PYG{+w}{				}\PYG{p}{\PYGZcb{}}
\PYG{+w}{				}\PYG{n}{peerRegistrado}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k}{this}\PYG{p}{;}
\PYG{+w}{			}\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{				}\PYG{c+c1}{// Registramos el nuevo donante en la mejor réplica encontrada}
\PYG{+w}{				}\PYG{c+c1}{// Como este método ya no bloquea globalmente, evitamos el deadlock}
\PYG{+w}{				}\PYG{n}{peerRegistrado}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{mejorPeer}\PYG{p}{.}\PYG{n+na}{registrar}\PYG{p}{(}\PYG{n}{donante}\PYG{p}{);}
\PYG{+w}{			}\PYG{p}{\PYGZcb{}}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}

\PYG{+w}{		}\PYG{c+c1}{// El cliente obtiene una referencia al stub del servidor donde se acaba }
\PYG{+w}{		}\PYG{c+c1}{// de registrar el donante, y así puede invocar a sus métodos.}
\PYG{+w}{		}\PYG{k}{return}\PYG{+w}{ }\PYG{n}{peerRegistrado}\PYG{p}{;}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}

\PYG{+w}{	}\PYG{c+cm}{/**}
\PYG{c+cm}{     * @brief Permite dar de baja a un donante.}
\PYG{c+cm}{     * @pre El donante debe estar registrado previamente.}
\PYG{c+cm}{     * @param donante El nombre del donante a dar de baja.}
\PYG{c+cm}{     * @throws RemoteException Si ocurre un error de comunicación remota.}
\PYG{c+cm}{     */}
\PYG{+w}{	}\PYG{n+nd}{@Override}
\PYG{+w}{    }\PYG{k+kd}{public}\PYG{+w}{ }\PYG{k+kd}{synchronized}\PYG{+w}{ }\PYG{k+kt}{void}\PYG{+w}{ }\PYG{n+nf}{darDeBaja}\PYG{p}{(}\PYG{n}{String}\PYG{+w}{ }\PYG{n}{donante}\PYG{p}{)}\PYG{+w}{ }\PYG{k+kd}{throws}\PYG{+w}{ }\PYG{n}{RemoteException}\PYG{p}{\PYGZob{}}
\PYG{+w}{		}\PYG{c+c1}{// Comprobamos que el donante esté registrado en esta réplica}
\PYG{+w}{		}\PYG{k}{if}\PYG{p}{(}\PYG{k}{this}\PYG{p}{.}\PYG{n+na}{estaRegistrado}\PYG{p}{(}\PYG{n}{donante}\PYG{p}{))\PYGZob{}}
\PYG{+w}{			}\PYG{n}{donantes}\PYG{p}{.}\PYG{n+na}{remove}\PYG{p}{(}\PYG{n}{donante}\PYG{p}{);}
\PYG{+w}{			}\PYG{n}{System}\PYG{p}{.}\PYG{n+na}{out}\PYG{p}{.}\PYG{n+na}{println}\PYG{p}{(}\PYG{l+s}{\PYGZdq{}[INFO.] El donante \PYGZdq{}}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{donante}
\PYG{+w}{				}\PYG{o}{+}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{} ha sido dado de baja en \PYGZdq{}}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{k}{this}\PYG{p}{.}\PYG{n+na}{getNombre}\PYG{p}{()}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{}.\PYGZdq{}}\PYG{p}{);}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}\PYG{n}{System}\PYG{p}{.}\PYG{n+na}{out}\PYG{p}{.}\PYG{n+na}{println}\PYG{p}{(}\PYG{l+s}{\PYGZdq{}[ERROR.] El donante \PYGZdq{}}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n}{donante}
\PYG{+w}{				}\PYG{o}{+}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{} ha intentado darse de baja en \PYGZdq{}}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{k}{this}\PYG{p}{.}\PYG{n+na}{getNombre}\PYG{p}{()}
\PYG{+w}{				}\PYG{o}{+}\PYG{+w}{ }\PYG{l+s}{\PYGZdq{} pero no está registrado en esta réplica.\PYGZdq{}}\PYG{p}{);}
