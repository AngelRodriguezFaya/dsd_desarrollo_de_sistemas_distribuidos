\PYG{+w}{			}\PYG{k}{for}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{iDonacion}\PYG{+w}{ }\PYG{n}{peer}\PYG{+w}{ }\PYG{p}{:}\PYG{+w}{ }\PYG{n}{peers}\PYG{p}{.}\PYG{n+na}{values}\PYG{p}{())}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
