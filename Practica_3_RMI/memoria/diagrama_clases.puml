@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80

interface java.rmi.Remote {
}

interface iDonacion {
  + getNombre(): String
  + setPeer(peer: iDonacion): void
  + totalDonantes(): int
  + estaRegistrado(donante: String): boolean
  + getTotalDonacionesLocal(): int
  + listarDonantesLocal(): List<String>
  + darDeBaja(donante: String): void
  + registrar(donante: String): iDonacion
  + donar(donante: String, cantidad: int): void
  + totalDonaciones(donante: String): int
  + listarDonantes(donante: String): List<String>
  + getTotalDonacionesDonante(donante: String): int
  + mayorDonanteGlobal(): String
  + obtenerHistorialDonaciones(donante: String): List<Integer>
}

class Donacion {
  - nombreNodo: String
  - totalDonacionesLocal: int
  - donantes: Map<String, List<Integer>>
  - peers: Map<String, iDonacion>
  + Donacion(nombreNodo: String)
}

class Servidor {
  - {static} RMI_PORT: int
  - {static} generateName(registry: Registry): String
  + {static} main(args: String[]): void
}

class Cliente {
  + {static} mostrarSeparador(scanner: Scanner): void
  + {static} main(args: String[]): void
}

java.rmi.Remote <|-- iDonacion
Donacion .up.|> iDonacion : Implements

Servidor ..> Donacion : Instancia y registra >
Cliente ..> iDonacion : Invoca métodos remotamente >

Donacion "1" *-right- "*" iDonacion :  "peers"
@enduml
