\PYG{n}{resultados}\PYG{+w}{ }\PYG{o}{*}
\PYG{n+nf}{calcular\PYGZus{}lotes\PYGZus{}1\PYGZus{}svc}\PYG{p}{(}\PYG{n}{operaciones}\PYG{+w}{ }\PYG{n}{arg1}\PYG{p}{,}\PYG{+w}{  }\PYG{k}{struct}\PYG{+w}{ }\PYG{n+nc}{svc\PYGZus{}req}\PYG{+w}{ }\PYG{o}{*}\PYG{n}{rqstp}\PYG{p}{)\PYGZob{}}
\PYG{+w}{	}\PYG{k}{static}\PYG{+w}{ }\PYG{n}{resultados}\PYG{+w}{ }\PYG{n}{result}\PYG{p}{;}

\PYG{+w}{	}\PYG{k}{static}\PYG{+w}{ }\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{resultados\PYGZus{}aux}\PYG{p}{[}\PYG{n}{MAX\PYGZus{}OP}\PYG{p}{];}\PYG{+w}{ }\PYG{c+cm}{/*Array estático auxiliar para almacenar los resultados*/}

\PYG{+w}{	}\PYG{k}{for}\PYG{+w}{ }\PYG{p}{(}\PYG{k+kt}{int}\PYG{+w}{ }\PYG{n}{i}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}\PYG{+w}{ }\PYG{n}{i}\PYG{+w}{ }\PYG{o}{\PYGZlt{}}\PYG{+w}{ }\PYG{n}{arg1}\PYG{p}{.}\PYG{n}{operaciones\PYGZus{}len}\PYG{p}{;}\PYG{+w}{ }\PYG{n}{i}\PYG{o}{++}\PYG{p}{)\PYGZob{}}
\PYG{+w}{		}\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{op1}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{arg1}\PYG{p}{.}\PYG{n}{operaciones\PYGZus{}val}\PYG{p}{[}\PYG{n}{i}\PYG{p}{].}\PYG{n}{op1}\PYG{p}{;}
\PYG{+w}{		}\PYG{k+kt}{double}\PYG{+w}{ }\PYG{n}{op2}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{arg1}\PYG{p}{.}\PYG{n}{operaciones\PYGZus{}val}\PYG{p}{[}\PYG{n}{i}\PYG{p}{].}\PYG{n}{op2}\PYG{p}{;}
\PYG{+w}{		}\PYG{k+kt}{char}\PYG{+w}{ }\PYG{n}{operador}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{arg1}\PYG{p}{.}\PYG{n}{operaciones\PYGZus{}val}\PYG{p}{[}\PYG{n}{i}\PYG{p}{].}\PYG{n}{operador}\PYG{p}{;}
\PYG{+w}{		}\PYG{n}{resultados\PYGZus{}aux}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{realizar\PYGZus{}operacion}\PYG{p}{(}\PYG{n}{op1}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{op2}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{operador}\PYG{p}{);}
\PYG{+w}{	}\PYG{p}{\PYGZcb{}}
\PYG{+w}{	}\PYG{c+cm}{/* Ahora hacemos que result apunte al array auxiliar de resultados*/}
\PYG{+w}{	}\PYG{n}{result}\PYG{p}{.}\PYG{n}{resultados\PYGZus{}val}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{resultados\PYGZus{}aux}\PYG{p}{;}
\PYG{+w}{	}\PYG{n}{result}\PYG{p}{.}\PYG{n}{resultados\PYGZus{}len}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{arg1}\PYG{p}{.}\PYG{n}{operaciones\PYGZus{}len}\PYG{p}{;}\PYG{+w}{ }\PYG{c+cm}{/* Ya que hay el mismo nro de operaciones (y resultados) en resultados\PYGZus{}aux que en arg1*/}

\PYG{+w}{	}\PYG{k}{return}\PYG{+w}{ }\PYG{o}{\PYGZam{}}\PYG{n}{result}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}
