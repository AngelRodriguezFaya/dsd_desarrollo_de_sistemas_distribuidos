\PYG{+w}{			}\PYG{n}{result}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{multiplicacion\PYGZus{}1}\PYG{p}{(}\PYG{n}{op1}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{op2}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{clnt}\PYG{p}{);}
