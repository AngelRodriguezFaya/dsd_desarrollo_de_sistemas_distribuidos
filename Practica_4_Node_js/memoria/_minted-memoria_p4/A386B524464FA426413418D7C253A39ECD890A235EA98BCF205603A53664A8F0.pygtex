\PYG{+w}{                }\PYG{n+nx}{notificarAlerta}\PYG{p}{(}\PYG{l+s+sb}{`💡 Está oscuro en }\PYG{l+s+si}{\PYGZdl{}\PYGZob{}}\PYG{n+nx}{ubicacion}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+sb}{ (}\PYG{l+s+si}{\PYGZdl{}\PYGZob{}}\PYG{n+nx}{luminosidadActual}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+sb}{ lux) y se ha detectado movimiento.`}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }
\PYG{+w}{                    }\PYG{l+s+sb}{` \PYGZlt{}strong\PYGZgt{}¡Te encendiendo la luz!\PYGZlt{}/strong\PYGZgt{}`}\PYG{p}{);}

\PYG{+w}{                }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{estadoActuadores}\PYG{p}{.}\PYG{n+nx}{luz}\PYG{p}{[}\PYG{n+nx}{ubicacion}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{n+nx}{EstadoLuz}\PYG{p}{.}\PYG{n+nx}{APAGADA}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                    }\PYG{n+nx}{estadoActuadores}\PYG{p}{.}\PYG{n+nx}{luz}\PYG{p}{[}\PYG{n+nx}{ubicacion}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{EstadoLuz}\PYG{p}{.}\PYG{n+nx}{ENCENDIDA}\PYG{p}{;}
\PYG{+w}{                    }\PYG{n+nx}{io}\PYG{p}{.}\PYG{n+nx}{sockets}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}dashboard:update\PYGZhy{}actuadores\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{estadoActuadores}\PYG{p}{);}
\PYG{+w}{                }\PYG{p}{\PYGZcb{}}
\PYG{+w}{            }\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{log}\PYG{p}{(}\PYG{l+s+sb}{`[AGENTE] Movimiento en }\PYG{l+s+si}{\PYGZdl{}\PYGZob{}}\PYG{n+nx}{ubicacion}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+sb}{, pero hay suficiente luz (}\PYG{l+s+si}{\PYGZdl{}\PYGZob{}}\PYG{n+nx}{luminosidadActual}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+sb}{ lux). No enciendo la bombilla.`}\PYG{p}{);}
\PYG{+w}{            }\PYG{p}{\PYGZcb{}}
\PYG{+w}{        }\PYG{p}{\PYGZcb{}}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}

\PYG{+w}{    }\PYG{c+c1}{// Regla del Videoportero: }
\PYG{+w}{    }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{tipo}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}Videovigilancia\PYGZsq{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{n+nx}{ubicacion}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}Portal\PYGZsq{}}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{valor}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+m+mf}{1}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{+w}{ }\PYG{c+c1}{// Si se detecta movimiento en el portal, enviamos una alerta de que alguien está en la puerta.}

\PYG{+w}{            }\PYG{c+c1}{// 1. Notificamos la alerta tanto en el dashboard como por Telegram}
\PYG{+w}{            }\PYG{n+nx}{notificarAlerta}\PYG{p}{(}\PYG{l+s+sb}{`📹 \PYGZlt{}strong\PYGZgt{}[SEGURIDAD]\PYGZlt{}/strong\PYGZgt{} ¡Alerta de actividad en el Portal! La cámara de seguridad ha comenzado a grabar.`}\PYG{p}{);}

\PYG{+w}{            }\PYG{c+c1}{// 2. Enviamos el GIF visual exclusivamente por Telegram}
\PYG{+w}{            }\PYG{k}{if}\PYG{+w}{ }\PYG{p}{(}\PYG{n+nx}{miChatId}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                }\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{gifAlerta}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}https://media.giphy.com/media/Pag51BshRuVqg/giphy.gif\PYGZsq{}}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// GIF de alerta de seguridad}
\PYG{+w}{                }
\PYG{+w}{                }\PYG{n+nx}{telegramBot}\PYG{p}{.}\PYG{n+nx}{sendAnimation}\PYG{p}{(}\PYG{n+nx}{miChatId}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{gifAlerta}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                    }\PYG{n+nx}{caption}\PYG{o}{:}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}👀 Esto es lo que ha capturado la cámara de seguridad en tiempo real. 👀\PYGZsq{}}
\PYG{+w}{                }\PYG{p}{\PYGZcb{}).}\PYG{k}{catch}\PYG{p}{(}\PYG{n+nx}{err}\PYG{+w}{ }\PYG{p}{=\PYGZgt{}}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                    }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{error}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}[TELEGRAM ERROR] No se pudo enviar el GIF:\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{err}\PYG{p}{.}\PYG{n+nx}{message}\PYG{p}{);}
\PYG{+w}{                }\PYG{p}{\PYGZcb{});}
