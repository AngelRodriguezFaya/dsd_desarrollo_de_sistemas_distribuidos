\PYG{+w}{        }\PYG{p}{.}\PYG{n+nx}{sort}\PYG{p}{(\PYGZob{}}\PYG{n+nx}{registeredAt}\PYG{o}{:}\PYG{+w}{ }\PYG{o}{\PYGZhy{}}\PYG{l+m+mf}{1}\PYG{p}{\PYGZcb{})}
\PYG{+w}{        }\PYG{p}{.}\PYG{n+nx}{toArray}\PYG{p}{();}

\PYG{+w}{	}\PYG{c+c1}{//Las mostramos por consola en formato tabla}
\PYG{+w}{    }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{log}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}Sensores registrados actualmente en la base de datos:\PYGZsq{}}\PYG{p}{);}
\PYG{+w}{    }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{table}\PYG{p}{(}\PYG{n+nx}{sensors}\PYG{p}{);}
\PYG{p}{\PYGZcb{}}

\PYG{c+c1}{// ===========================================================================}
\PYG{c+c1}{//                       SERVIDOR HTTP (Servir archivos)}
\PYG{c+c1}{// ===========================================================================}

\PYG{c+c1}{// Creamos el servidor http.}
\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{httpServer}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{http}\PYG{p}{.}\PYG{n+nx}{createServer}\PYG{p}{((}\PYG{n+nx}{request}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{response}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{=\PYGZgt{}}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{k+kd}{const}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{n+nx}{method}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{url}\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{request}\PYG{p}{;}
\PYG{+w}{    }\PYG{k+kd}{let}\PYG{+w}{ }\PYG{n+nx}{filePath}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k+kc}{null}\PYG{p}{;}

\PYG{+w}{	}\PYG{c+c1}{//Para el home y la pagina sensores, cargar sensor.html, para la pagina dashboard, cargar dashboard.html}
\PYG{+w}{    }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{method}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}GET\PYGZsq{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{p}{(}\PYG{n+nx}{url}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}/\PYGZsq{}}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{n+nx}{url}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}/sensor.html\PYGZsq{}}\PYG{p}{))}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{n+nx}{filePath}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{join}\PYG{p}{(}\PYG{n+nx}{process}\PYG{p}{.}\PYG{n+nx}{cwd}\PYG{p}{(),}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}sensor.html\PYGZsq{}}\PYG{p}{);}

\PYG{+w}{    }\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{k}{if}\PYG{p}{(}\PYG{+w}{ }\PYG{n+nx}{method}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}GET\PYGZsq{}}\PYG{+w}{ }\PYG{o}{\PYGZam{}\PYGZam{}}\PYG{+w}{ }\PYG{n+nx}{url}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}/dashboard.html\PYGZsq{}}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{n+nx}{filePath}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{join}\PYG{p}{(}\PYG{n+nx}{process}\PYG{p}{.}\PYG{n+nx}{cwd}\PYG{p}{(),}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}dashboard.html\PYGZsq{}}\PYG{p}{);}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}

\PYG{+w}{    }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{filePath}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{c+c1}{//Leemos el contenido de sensor.html y lo guardamos en data}
\PYG{+w}{        }\PYG{n+nx}{readFile}\PYG{p}{(}\PYG{n+nx}{filePath}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{(}\PYG{n+nx}{err}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{data}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{=\PYGZgt{}}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{            }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{err}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                }\PYG{n+nx}{response}\PYG{p}{.}\PYG{n+nx}{writeHead}\PYG{p}{(}\PYG{l+m+mf}{500}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}Content\PYGZhy{}Type\PYGZsq{}}\PYG{o}{:}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}text/plain; charset=utf\PYGZhy{}8\PYGZsq{}}\PYG{p}{\PYGZcb{});}
\PYG{+w}{                }\PYG{n+nx}{response}\PYG{p}{.}\PYG{n+nx}{end}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}No se pudo cargar el HTML.\PYGZsq{}}\PYG{p}{);}
\PYG{+w}{            }\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                }\PYG{c+c1}{//Devolvemos al navegador una página creada a partir de data}
\PYG{+w}{                }\PYG{n+nx}{response}\PYG{p}{.}\PYG{n+nx}{writeHead}\PYG{p}{(}\PYG{l+m+mf}{200}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}Content\PYGZhy{}Type\PYGZsq{}}\PYG{o}{:}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}text/html; charset=utf\PYGZhy{}8\PYGZsq{}}\PYG{p}{\PYGZcb{});}
\PYG{+w}{                }\PYG{n+nx}{response}\PYG{p}{.}\PYG{n+nx}{end}\PYG{p}{(}\PYG{n+nx}{data}\PYG{p}{);}
\PYG{+w}{            }\PYG{p}{\PYGZcb{}}
\PYG{+w}{            }\PYG{n+nx}{response}\PYG{p}{.}\PYG{n+nx}{end}\PYG{p}{();}
\PYG{+w}{        }\PYG{p}{\PYGZcb{});}\PYG{+w}{    }
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{c+c1}{//En caso de que la ruta no sea ni \PYGZsq{}/\PYGZsq{} ni \PYGZsq{}/dashboard.html\PYGZsq{}, devolvemos un error 404}
\PYG{+w}{        }\PYG{n+nx}{response}\PYG{p}{.}\PYG{n+nx}{writeHead}\PYG{p}{(}\PYG{l+m+mf}{404}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}Content\PYGZhy{}Type\PYGZsq{}}\PYG{o}{:}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}text/plain; charset=utf\PYGZhy{}8\PYGZsq{}}\PYG{p}{\PYGZcb{});}
\PYG{+w}{        }\PYG{n+nx}{response}\PYG{p}{.}\PYG{n+nx}{end}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}Ruta no encontrada.\PYGZsq{}}\PYG{p}{);}
\PYG{+w}{        }\PYG{n+nx}{response}\PYG{p}{.}\PYG{n+nx}{end}\PYG{p}{();}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}
\PYG{p}{\PYGZcb{});}

\PYG{c+c1}{// ===========================================================================}
\PYG{c+c1}{//                  SERVIDOR EN TIEMPO REAL (Socket.IO)}
\PYG{c+c1}{// ===========================================================================}

\PYG{c+c1}{// Iniciamos el servidor HTTP y Socket.IO.}
\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{io}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{o+ow}{new}\PYG{+w}{ }\PYG{n+nx}{Server}\PYG{p}{(}\PYG{n+nx}{httpServer}\PYG{p}{);}\PYG{+w}{ }\PYG{c+c1}{// Engancha Socket.io al servidor HTTP, abriendo el canal para WebSockets}

\PYG{c+c1}{// \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{} Inicializamos la infraestructura del servidor \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{k}{async}\PYG{+w}{ }\PYG{k+kd}{function}\PYG{+w}{ }\PYG{n+nx}{startServer}\PYG{p}{()}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{k}{try}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{		}\PYG{c+c1}{//Levantamos mongo}
\PYG{+w}{        }\PYG{k}{await}\PYG{+w}{ }\PYG{n+nx}{connectToMongo}\PYG{p}{();}

\PYG{+w}{		}\PYG{c+c1}{// Levantamos el servidor web en el puerto}
\PYG{+w}{        }\PYG{n+nx}{httpServer}\PYG{p}{.}\PYG{n+nx}{listen}\PYG{p}{(}\PYG{n+nx}{PORT}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{()}\PYG{+w}{ }\PYG{p}{=\PYGZgt{}}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{            }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{log}\PYG{p}{(}\PYG{l+s+sb}{`Servidor basico escuchando en http://localhost:}\PYG{l+s+si}{\PYGZdl{}\PYGZob{}}\PYG{n+nx}{PORT}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+sb}{`}\PYG{p}{);}
\PYG{+w}{        }\PYG{p}{\PYGZcb{});}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{catch}\PYG{p}{(}\PYG{n+nx}{err}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{error}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}No se pudo iniciar el servidor:\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{err}\PYG{p}{.}\PYG{n+nx}{message}\PYG{p}{);}
\PYG{+w}{        }\PYG{n+nx}{process}\PYG{p}{.}\PYG{n+nx}{exit}\PYG{p}{(}\PYG{l+m+mf}{1}\PYG{p}{);}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}
\PYG{p}{\PYGZcb{}}

\PYG{c+c1}{// Manejar la conexion de Socket.IO}
\PYG{n+nx}{io}\PYG{p}{.}\PYG{n+nx}{on}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}connection\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{(}\PYG{n+nx}{socket}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{=\PYGZgt{}}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{log}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}Nuevo nodo conectado: \PYGZsq{}}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{n+nx}{socket}\PYG{p}{.}\PYG{n+nx}{id}\PYG{p}{);}

\PYG{+w}{    }\PYG{c+c1}{// Al conectarse el Dashboard, le enviamos el estado actual de los actuadores para que se muestre correctamente en la interfaz.}
\PYG{+w}{    }\PYG{n+nx}{socket}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}dashboard:update\PYGZhy{}actuadores\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{estadoActuadores}\PYG{p}{);}

\PYG{+w}{    }\PYG{c+c1}{// [Evento 1]: Registro de sensores }
\PYG{+w}{    }\PYG{n+nx}{socket}\PYG{p}{.}\PYG{n+nx}{on}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}sensor:register\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{k}{async}\PYG{+w}{ }\PYG{p}{(}\PYG{n+nx}{payload}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{=\PYGZgt{}}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{+w}{ }\PYG{c+c1}{// payload son los datos del formulario enviados por el cliente}
\PYG{+w}{        }\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{sensorData}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{            }\PYG{c+c1}{//Extraemos los datos del payload, asegurándonos de que sean strings y eliminando espacios innecesarios.}
\PYG{+w}{            }\PYG{n+nx}{name}\PYG{o}{:}\PYG{+w}{ }\PYG{n+nb}{String}\PYG{p}{(}\PYG{n+nx}{payload}\PYG{o}{?}\PYG{p}{.}\PYG{n+nx}{name}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}\PYGZsq{}}\PYG{p}{).}\PYG{n+nx}{trim}\PYG{p}{(),}
\PYG{+w}{            }\PYG{n+nx}{location}\PYG{o}{:}\PYG{+w}{ }\PYG{n+nb}{String}\PYG{p}{(}\PYG{n+nx}{payload}\PYG{o}{?}\PYG{p}{.}\PYG{n+nx}{location}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}\PYGZsq{}}\PYG{p}{).}\PYG{n+nx}{trim}\PYG{p}{(),}
\PYG{+w}{            }\PYG{n+nx}{type}\PYG{o}{:}\PYG{+w}{ }\PYG{n+nb}{String}\PYG{p}{(}\PYG{n+nx}{payload}\PYG{o}{?}\PYG{p}{.}\PYG{n+nx}{type}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}\PYGZsq{}}\PYG{p}{).}\PYG{n+nx}{trim}\PYG{p}{()}
\PYG{+w}{        }\PYG{p}{\PYGZcb{};}

\PYG{+w}{        }\PYG{c+c1}{// Validamos que se hayan proporcionado los campos obligatorios.}
\PYG{+w}{        }\PYG{k}{if}\PYG{p}{(}\PYG{o}{!}\PYG{n+nx}{sensorData}\PYG{p}{.}\PYG{n+nx}{name}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{o}{!}\PYG{n+nx}{sensorData}\PYG{p}{.}\PYG{n+nx}{location}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{o}{!}\PYG{n+nx}{sensorData}\PYG{p}{.}\PYG{n+nx}{type}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{            }\PYG{c+c1}{// Emitimos un evento de error al cliente que intenta registrar el sensor.}
\PYG{+w}{			}\PYG{n+nx}{socket}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}sensor:error\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}Faltan campos obligatorios.\PYGZsq{}}\PYG{p}{);}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{			}\PYG{k}{try}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{				}\PYG{c+c1}{//Intentamos incluir el sensor en la BD}
\PYG{+w}{				}\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{sensor}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{k}{await}\PYG{+w}{ }\PYG{n+nx}{registerSensor}\PYG{p}{(}\PYG{n+nx}{sensorData}\PYG{p}{);}

\PYG{+w}{				}\PYG{c+c1}{//Mostramos la colección de sensores completa}
\PYG{+w}{				}\PYG{k}{await}\PYG{+w}{ }\PYG{n+nx}{logRegisteredSensors}\PYG{p}{();}
\PYG{+w}{				}\PYG{n+nx}{socket}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}sensor:registered\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{sensor}\PYG{p}{);}

\PYG{+w}{			}\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{catch}\PYG{p}{(}\PYG{n+nx}{err}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{				}\PYG{c+c1}{//En caso de error, emitir evento de error al sensor.}
\PYG{+w}{				}\PYG{n+nx}{socket}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}sensor:error\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}Error registrando el sensor en la base de datos.\PYGZsq{}}\PYG{p}{);}
\PYG{+w}{			}\PYG{p}{\PYGZcb{}}
\PYG{+w}{		}\PYG{p}{\PYGZcb{}}
\PYG{+w}{    }\PYG{p}{\PYGZcb{});}

\PYG{+w}{    }\PYG{c+c1}{// [Evento 2]: Recepción de medidas del sensor}
\PYG{+w}{    }\PYG{n+nx}{socket}\PYG{p}{.}\PYG{n+nx}{on}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}sensor:data\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{k}{async}\PYG{+w}{ }\PYG{p}{(}\PYG{n+nx}{payload}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{=\PYGZgt{}}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{k}{try}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{            }\PYG{c+c1}{// Creamos el documento }
\PYG{+w}{            }\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{medidaNueva}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                }\PYG{n+nx}{sensorId}\PYG{o}{:}\PYG{+w}{ }\PYG{n+nx}{payload}\PYG{p}{.}\PYG{n+nx}{sensorId}\PYG{p}{,}\PYG{+w}{ }
\PYG{+w}{                }\PYG{n+nx}{name}\PYG{o}{:}\PYG{+w}{ }\PYG{n+nx}{payload}\PYG{p}{.}\PYG{n+nx}{name}\PYG{p}{,}
\PYG{+w}{                }\PYG{n+nx}{type}\PYG{o}{:}\PYG{+w}{ }\PYG{n+nx}{payload}\PYG{p}{.}\PYG{n+nx}{type}\PYG{p}{,}
\PYG{+w}{                }\PYG{n+nx}{location}\PYG{o}{:}\PYG{+w}{ }\PYG{n+nx}{payload}\PYG{p}{.}\PYG{n+nx}{location}\PYG{p}{,}
\PYG{+w}{                }\PYG{n+nx}{value}\PYG{o}{:}\PYG{+w}{ }\PYG{n+nb}{parseFloat}\PYG{p}{(}\PYG{n+nx}{payload}\PYG{p}{.}\PYG{n+nx}{value}\PYG{p}{),}\PYG{+w}{ }
\PYG{+w}{                }\PYG{n+nx}{timestamp}\PYG{o}{:}\PYG{+w}{ }\PYG{o+ow}{new}\PYG{+w}{ }\PYG{n+nb}{Date}\PYG{p}{()}\PYG{+w}{ }
\PYG{+w}{            }\PYG{p}{\PYGZcb{};}

\PYG{+w}{            }\PYG{c+c1}{// 1. Insertamos el documento en la colección \PYGZdq{}historial\PYGZdq{}}
\PYG{+w}{            }\PYG{k}{await}\PYG{+w}{ }\PYG{n+nx}{historialCollection}\PYG{p}{.}\PYG{n+nx}{insertOne}\PYG{p}{(}\PYG{n+nx}{medidaNueva}\PYG{p}{);}
\PYG{+w}{            }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{log}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}[BD] Nueva medida registrada:\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{medidaNueva}\PYG{p}{);}
\PYG{+w}{            }
\PYG{+w}{            }\PYG{c+c1}{// 2. Reenviamos (en tiempo real) la medida a todos los clientes conectados (incluido el que la envió) para que puedan actualizar su dashboard.}
\PYG{+w}{            }\PYG{n+nx}{io}\PYG{p}{.}\PYG{n+nx}{sockets}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}dashboard:update\PYGZhy{}sensor\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{medidaNueva}\PYG{p}{);}

\PYG{+w}{            }\PYG{c+c1}{// 3. Llamamos al agente}
\PYG{+w}{            }\PYG{n+nx}{ejecutarAgente}\PYG{p}{(}\PYG{n+nx}{medidaNueva}\PYG{p}{);}

\PYG{+w}{        }\PYG{p}{\PYGZcb{}}\PYG{+w}{ }\PYG{k}{catch}\PYG{p}{(}\PYG{n+nx}{err}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{            }\PYG{n+nx}{console}\PYG{p}{.}\PYG{n+nx}{error}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}[ERROR] Error registrando la medida en la base de datos:\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{err}\PYG{p}{.}\PYG{n+nx}{message}\PYG{p}{);}
