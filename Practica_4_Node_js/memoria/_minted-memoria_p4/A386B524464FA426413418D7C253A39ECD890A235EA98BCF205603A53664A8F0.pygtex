\PYG{+w}{                }\PYG{n+nx}{estadoActuadores}\PYG{p}{.}\PYG{n+nx}{aireAcondicionado}\PYG{p}{[}\PYG{n+nx}{ubicacion}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{EstadoAC}\PYG{p}{.}\PYG{n+nx}{APAGADO}\PYG{p}{;}
\PYG{+w}{                }\PYG{n+nx}{io}\PYG{p}{.}\PYG{n+nx}{sockets}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}dashboard:update\PYGZhy{}actuadores\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{estadoActuadores}\PYG{p}{);}
\PYG{+w}{                }\PYG{n+nx}{msg}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{msg}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{l+s+sb}{` \PYGZlt{}strong\PYGZgt{}Apagando A/C automáticamente.\PYGZlt{}/strong\PYGZgt{}`}\PYG{p}{;}
\PYG{+w}{            }\PYG{p}{\PYGZcb{}}

\PYG{+w}{            }\PYG{c+c1}{// Enviamos la alerta al dashboard y por Telegram}
