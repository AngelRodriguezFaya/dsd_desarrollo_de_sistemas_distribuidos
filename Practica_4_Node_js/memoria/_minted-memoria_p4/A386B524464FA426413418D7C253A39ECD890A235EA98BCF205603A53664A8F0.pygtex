\PYG{+w}{                }\PYG{n+nx}{estadoActuadores}\PYG{p}{.}\PYG{n+nx}{persiana}\PYG{p}{[}\PYG{n+nx}{ubicacion}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{EstadoPersiana}\PYG{p}{.}\PYG{n+nx}{CERRADA}\PYG{p}{;}
\PYG{+w}{                }\PYG{n+nx}{io}\PYG{p}{.}\PYG{n+nx}{sockets}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}dashboard:update\PYGZhy{}actuadores\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{estadoActuadores}\PYG{p}{);}
\PYG{+w}{                }\PYG{n+nx}{msg}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{msg}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{l+s+sb}{` \PYGZlt{}strong\PYGZgt{}Cerrando persiana automáticamente.\PYGZlt{}/strong\PYGZgt{}`}\PYG{p}{;}
