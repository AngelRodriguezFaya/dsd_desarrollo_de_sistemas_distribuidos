\PYG{+w}{            }\PYG{k+kd}{const}\PYG{+w}{ }\PYG{n+nx}{luminosidadActual}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{memoriaLuminosidad}\PYG{p}{[}\PYG{n+nx}{ubicacion}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{||}\PYG{+w}{ }\PYG{l+m+mf}{500}\PYG{p}{;}

