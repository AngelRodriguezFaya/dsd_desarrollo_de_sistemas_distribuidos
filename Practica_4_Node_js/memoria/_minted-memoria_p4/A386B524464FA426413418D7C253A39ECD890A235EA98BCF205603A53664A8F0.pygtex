\PYG{+w}{        }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{valor}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{l+m+mf}{1}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}\PYG{+w}{ }\PYG{c+c1}{// Si se detecta movimiento}
\PYG{+w}{            }\PYG{c+c1}{// notificarAlerta(`👀 Movimiento detectado en \PYGZdl{}\PYGZob{}ubicacion\PYGZcb{}.`);}

