\PYG{+w}{            }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{estadoActuadores}\PYG{p}{.}\PYG{n+nx}{alarmaGas}\PYG{p}{[}\PYG{n+nx}{ubicacion}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{===}\PYG{+w}{ }\PYG{n+nx}{EstadoAlarmaGas}\PYG{p}{.}\PYG{n+nx}{INACTIVA}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{                }\PYG{n+nx}{estadoActuadores}\PYG{p}{.}\PYG{n+nx}{alarmaGas}\PYG{p}{[}\PYG{n+nx}{ubicacion}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{EstadoAlarmaGas}\PYG{p}{.}\PYG{n+nx}{ACTIVA}\PYG{p}{;}
\PYG{+w}{                }\PYG{n+nx}{io}\PYG{p}{.}\PYG{n+nx}{sockets}\PYG{p}{.}\PYG{n+nx}{emit}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}dashboard:update\PYGZhy{}actuadores\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{estadoActuadores}\PYG{p}{);}
\PYG{+w}{                }\PYG{n+nx}{msg}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{msg}\PYG{+w}{ }\PYG{o}{+}\PYG{+w}{ }\PYG{l+s+sb}{` \PYGZlt{}strong\PYGZgt{}Se ha activado la alarma de gas. Por favor, revisa tu hogar inmediatamente.\PYGZlt{}/strong\PYGZgt{}`}\PYG{p}{;}
