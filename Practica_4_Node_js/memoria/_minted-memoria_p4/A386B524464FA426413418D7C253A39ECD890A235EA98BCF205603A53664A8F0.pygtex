\PYG{p}{\PYGZcb{}}

\PYG{c+c1}{// ===========================================================================}
\PYG{c+c1}{//   Cierre limpio de MongoDB al detener el proceso (Ctrl+C). }
\PYG{c+c1}{// ===========================================================================}
\PYG{c+c1}{// Detecta cuando pulsas Ctrl+C en la terminal para apagar el servidor }
\PYG{c+c1}{// y se asegura de cerrar la conexión con MongoDB limpiamente antes de matar el proceso.}
\PYG{n+nx}{process}\PYG{p}{.}\PYG{n+nx}{on}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}SIGINT\PYGZsq{}}\PYG{p}{,}\PYG{+w}{ }\PYG{k}{async}\PYG{+w}{ }\PYG{p}{()}\PYG{+w}{ }\PYG{p}{=\PYGZgt{}}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{	}\PYG{c+c1}{//Si la conexión con el servidor de mongoDB está activa, la cierra}
\PYG{+w}{    }\PYG{k}{if}\PYG{p}{(}\PYG{n+nx}{mongoClient}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{        }\PYG{k}{await}\PYG{+w}{ }\PYG{n+nx}{mongoClient}\PYG{p}{.}\PYG{n+nx}{close}\PYG{p}{();}
\PYG{+w}{    }\PYG{p}{\PYGZcb{}}

\PYG{+w}{	}\PYG{c+c1}{//Mata el proceso del servidor}
\PYG{+w}{    }\PYG{n+nx}{process}\PYG{p}{.}\PYG{n+nx}{exit}\PYG{p}{(}\PYG{l+m+mf}{0}\PYG{p}{);}
\PYG{p}{\PYGZcb{});}

\PYG{c+c1}{// ===========================================================================}
\PYG{c+c1}{//                  Arrancamos el sistema por completo}
\PYG{c+c1}{// ===========================================================================}
\PYG{n+nx}{startServer}\PYG{p}{();}
