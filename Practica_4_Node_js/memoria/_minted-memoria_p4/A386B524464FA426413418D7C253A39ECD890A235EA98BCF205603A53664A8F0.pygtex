\PYG{+w}{                }\PYG{n+nx}{estadoActuadores}\PYG{p}{.}\PYG{n+nx}{aireAcondicionado}\PYG{p}{[}\PYG{n+nx}{ubicacion}\PYG{p}{]}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n+nx}{EstadoAC}\PYG{p}{.}\PYG{n+nx}{ENCENDIDO}\PYG{p}{;}
